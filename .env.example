# ===========================================
# Shopee Affiliate Manager - Environment
# ===========================================

# App
NODE_ENV=production
PORT=3000
APP_MODE=mock
# APP_MODE=live          ← ganti ke live setelah kredensial siap

# Admin token — WAJIB di production, melindungi semua endpoint /api.
# Generate: openssl rand -hex 32
ADMIN_TOKEN=

# Isi hanya jika frontend di-host terpisah dari backend.
# CORS_ORIGIN=https://dashboard.domain-anda.com

# PostgreSQL (EasyPanel biasanya inject DATABASE_URL)
DATABASE_URL=postgres://postgres:password@postgres:5432/shopee_affiliate

# Atau pecah manual:
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=shopee_affiliate
# DB_USER=postgres
# DB_PASSWORD=yourpassword
# DB_SSL=false

# Shopee Open Platform
SHOPEE_PARTNER_ID=200xxxx
SHOPEE_PARTNER_KEY=your_partner_key_here
SHOPEE_REGION=ID
SHOPEE_BASE_URL=https://partner.shopeemobile.com
# Sandbox: https://openplatform.sandbox.test-stable.shopee.sg

# Redirect URI untuk OAuth. HARUS sama persis dengan yang didaftarkan
# di Shopee Open Platform Console, termasuk http/https dan trailing slash.
SHOPEE_REDIRECT_URI=https://domain-anda.com/api/auth/callback

# Jumlah baris per halaman saat menarik data AMS. Shopee menolak 100
# ("invalid page_size"); 50 adalah batas aman. Turunkan bila masih ditolak.
SHOPEE_PAGE_SIZE=50
